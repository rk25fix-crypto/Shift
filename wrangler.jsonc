{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shift",
  "compatibility_date": "2026-08-22",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "vinext/server/fetch-handler",
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "cache": {
    "enabled": true
  },
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  // Plain-text vars set only via the Cloudflare dashboard ("テキスト" type,
  // not "シークレット") get wiped by the next `wrangler deploy` unless
  // they're declared here too — that silently broke BETTER_AUTH_URL-reliant
  // auth checks once already (docs/plan.md's Phase 1a.5 deploy notes).
  // BETTER_AUTH_SECRET / RESEND_API_KEY are true secrets (set as type
  // "シークレット" in the dashboard's Settings > Variables and Secrets) and
  // survive deploys on their own, but are declared as required here so a
  // deploy fails loudly if either is ever missing, instead of surfacing as
  // a buried "Missing API key" error deep in the auth flow.
  "vars": {
    "BETTER_AUTH_URL": "https://shift.sync-app-2026.workers.dev"
  },
  "secrets": {
    "required": ["BETTER_AUTH_SECRET", "RESEND_API_KEY"]
  },
  // migrations_dir must point at drizzle-kit's actual output (drizzle.config.ts's
  // `out: "./drizzle/migrations"`) — wrangler's own default ("./migrations")
  // doesn't exist in this repo, so `wrangler d1 migrations apply` silently
  // had nothing to apply until this was added (found via a fresh local D1
  // replica having zero tables, breaking any e2e test that touches the DB).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "shift-db",
      "database_id": "e4b0096f-322c-406d-8d76-9205b5396685",
      "migrations_dir": "drizzle/migrations"
    }
  ],
  "env": {
    "preview": {
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "shift-db-preview",
          "database_id": "90db1e8c-684f-4a03-84e9-c8ed6a179f41",
          "migrations_dir": "drizzle/migrations"
        }
      ]
    }
  }
}
