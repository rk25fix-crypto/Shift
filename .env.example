# Copy this file to .env.local for local development (see README.md).
# .env.local is gitignored — never commit real secrets.
#
# Note: the D1 database itself is a Cloudflare Workers binding (see
# wrangler.jsonc), not an env var — `vinext dev`/`wrangler dev` wire it up
# automatically from the local D1 replica.

# Better Auth
BETTER_AUTH_SECRET=generate-with-npx-@better-auth/cli-secret
BETTER_AUTH_URL=http://localhost:3000

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Resend (transactional email — see docs/plan.md "メール送信")
RESEND_API_KEY=re_...

# Note: ENABLE_TEST_UTILS (lets e2e/auth.spec.ts read back a sign-in OTP
# instead of a real inbox) can NOT be set here — wrangler.jsonc's
# `secrets.required` makes `wrangler dev`/`vinext dev` drop any var not
# already listed in `vars` or `secrets.required`, silently ignoring it.
# To run a login-based E2E test locally: `npm run e2e:server` in one
# terminal, then `npm run e2e` in another (see README.md). Never add this to
# a deployed Worker's vars/secrets.
