# Copy this file to .env.local for local development (see README.md).
# .env.local is gitignored — never commit real secrets.

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# service_role bypasses RLS — restricted by eslint.config.mjs to the Stripe
# webhook route and lib/admin/**. Never expose with a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Resend (transactional email — see docs/plan.md "メール送信")
RESEND_API_KEY=re_...
